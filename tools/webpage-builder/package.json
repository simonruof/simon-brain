{
  "name": "wb-prototyp-fabrik",
  "version": "1.0.0",
  "description": "Batch-Webpage-Builder fuer Schweizer KMU — Analyse, KI-Sichtbarkeits-Score, Prototyp, Outreach",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wb": "./bin/wb.js"
  },
  "scripts": {
    "wb": "node bin/wb.js",
    "mcp": "node src/mcp/server.js",
    "cockpit": "node src/server/api.js",
    "gui:dev": "vite --config gui/vite.config.js",
    "gui:build": "vite build --config gui/vite.config.js",
    "test": "node --test \"test/*.test.js\"",
    "fixtures": "node test/fixture-server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "playwright": "^1.56.0",
    "sharp": "^0.34.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.0"
  }
}

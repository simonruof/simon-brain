# Prototyp-Fabrik — Konfiguration
# Kopieren nach .env und ausfuellen. .env ist gitignored.

# --- Pflicht ---
# Claude API fuer Copy-Generierung (console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Places API (New) fuer Bewertungen, Fotos, Oeffnungszeiten, Umkreissuche
# console.cloud.google.com -> Places API (New) aktivieren
GOOGLE_PLACES_API_KEY=

# --- Optional ---
# PageSpeed Insights API. Ohne Key funktioniert es auch, aber stark rate-limited.
PAGESPEED_API_KEY=

# Modell fuer die Copy-Generierung. Sonnet im Batch (Kosten), Opus fuer Einzelstuecke.
WB_MODEL=claude-sonnet-5

# Deploy-Ziel (rsync). Leer lassen = kein Deploy moeglich.
WB_DEPLOY_HOST=
WB_DEPLOY_PATH=/var/www/preview
WB_PREVIEW_BASE_URL=https://preview.simonruof.ch

# Absender-Identitaet fuer Vorschau-Banner und Outreach
WB_SENDER_NAME=Simon Ruof
WB_SENDER_MAIL=simon.ruof@gmail.com
WB_SENDER_PHONE=

# Gueltigkeit einer Vorschau in Tagen
WB_PREVIEW_DAYS=14
